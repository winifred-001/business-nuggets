# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication
# Use long random values. Never commit real production secrets.
JWT_SECRET=replace-with-a-long-random-secret

# Optional legacy email-verification secret. If omitted, code that still
# references it falls back to JWT_SECRET.
EMAIL_OTP_SECRET=replace-with-another-long-random-secret

# Authenticator-based admin 2FA secret encryption key.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters

# Paystack payments
# Keep the secret key on the backend only. Start with a Paystack TEST secret.
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-test-secret-key
# Paystack redirects the browser here after checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# Cloudinary media storage
# Get these values from your Cloudinary Console/API Keys page.
# Never expose CLOUDINARY_API_SECRET in frontend code.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional display/storage-budget value used by the Admin Media Library.
MEDIA_STORAGE_LIMIT_BYTES=21474836480

# SMTP
# Port 587 normally uses SMTP_SECURE=false (STARTTLS).
# Port 465 normally uses SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Sender shown to recipients.
# Nodemailer accepts: Business Nuggets <no-reply@example.com>
SMTP_FROM=Business Nuggets <no-reply@example.com>

# Optional address for replies.
SMTP_REPLY_TO=support@example.com

# Keep your existing database/Prisma variables here as required
# by your deployment. Do not commit the real .env file.
